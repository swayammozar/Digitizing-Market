# Copy to .env.local for development, and add the same keys to Vercel under
# Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Bypasses row level security. Server-side only — never prefix with NEXT_PUBLIC_,
# and never paste it anywhere the browser can read.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Where processed images and preview videos are served from. Leave unset to use
# the local /public/media folder during development.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/public-media

# ---------------------------------------------------------------------------
# PayPal — used for USD. developer.paypal.com -> Apps & Credentials
#
# Leave these unset and the shop still runs: the card button explains that it
# is switched off rather than failing.
# ---------------------------------------------------------------------------
# "sandbox" (default) or "live". This alone switches environments.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The same client id, exposed to the browser so the SDK can render its button.
# Public by design — the secret above is what actually authorises anything.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# From the webhook you create in the PayPal dashboard, pointed at
# https://your-domain/api/webhooks/paypal and subscribed to
# PAYMENT.CAPTURE.COMPLETED.
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Razorpay — used for INR. dashboard.razorpay.com -> Settings -> API Keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Your own invented secret, entered when creating the webhook at
# https://your-domain/api/webhooks/razorpay for the payment.captured event.
RAZORPAY_WEBHOOK_SECRET=
