# Copy to .env.local for development, and add the same keys to Vercel under
# Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Bypasses row level security. Server-side only — never prefix with NEXT_PUBLIC_,
# and never paste it anywhere the browser can read.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Where processed images and preview videos are served from. Leave unset to use
# the local /public/media folder during development.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/public-media

# ---------------------------------------------------------------------------
# Payments — not wired up yet
# ---------------------------------------------------------------------------
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
